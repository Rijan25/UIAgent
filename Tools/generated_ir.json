    "sql_query_ir": {
      "sql_template": "SELECT sd.id, sd.name, sd.height, sd.weight FROM student_data sd WHERE (:search = '' OR sd.name LIKE '%' || :search || '%') ORDER BY sd.id DESC LIMIT :limit OFFSET :offset",
