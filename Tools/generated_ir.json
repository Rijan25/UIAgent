{
  "page_ir": {
    "page_goal": "Replicate UXpilot.ai UI design for generating Hifi UI and wireframes with design mode, style, type, font selection and prompt input",
    "style": {
      "tone": "professional",
      "theme": "light",
      "density": "comfortable",
      "color_intent": "purple-primary"
    },
    "accessibility": {
      "required_labels": [
        "design_mode_select",
        "style_select",
        "type_select",
        "font_select",
        "prompt_textarea"
      ]
    },
    "responsive": {
      "breakpoints": {},
      "collapse_rules": [],
      "hidden_on_small": []
    },
    "constraints": []
  },
  "data_ir": {
    "state": {
      "designMode": {
        "type": "string",
        "initial": "Hifi Designs",
        "required": true,
        "constraints": {}
      },
      "styleOption": {
        "type": "string",
        "initial": "default",
        "required": true,
        "constraints": {}
      },
      "deviceType": {
        "type": "string",
        "initial": "Desktop",
        "required": true,
        "constraints": {}
      },
      "fontFamily": {
        "type": "string",
        "initial": "Inter",
        "required": true,
        "constraints": {}
      },
      "promptText": {
        "type": "string",
        "initial": "Landing page for a job search platform",
        "required": true,
        "constraints": {}
      },
      "characterCount": {
        "type": "number",
        "initial": 38,
        "required": false,
        "constraints": {}
      }
    },
    "derived": {
      "isPromptValid": {
        "type": "boolean",
        "expr": "state.promptText.length >= 5"
      }
    }
  },
  "data_model_ir": {
    "entities": {}
  },
  "behaviour_ir": {
    "events": {
      "updateDesignMode": {
        "type": "mutation",
        "updates": [
          {
            "target": "state.designMode",
            "expr": "event.value"
          }
        ]
      },
      "updateStyle": {
        "type": "mutation",
        "updates": [
          {
            "target": "state.styleOption",
            "expr": "event.value"
          }
        ]
      },
      "updateDeviceType": {
        "type": "mutation",
        "updates": [
          {
            "target": "state.deviceType",
            "expr": "event.value"
          }
        ]
      },
      "updateFont": {
        "type": "mutation",
        "updates": [
          {
            "target": "state.fontFamily",
            "expr": "event.value"
          }
        ]
      },
      "updatePrompt": {
        "type": "mutation",
        "updates": [
          {
            "target": "state.promptText",
            "expr": "event.value"
          },
          {
            "target": "state.characterCount",
            "expr": "event.value.length"
          }
        ]
      }
    },
    "actions": {
      "generateDesign": {
        "action_id": "generateDesign",
        "trigger": "button_click",
        "target_component_id": "generate_button",
        "operation": "submit",
        "payload": {},
        "validation_rules": [
          "state.promptText.length >= 5"
        ],
        "requires_confirmation": false,
        "updates": []
      },
      "tryExample": {
        "action_id": "tryExample",
        "trigger": "button_click",
        "target_component_id": "try_example_button",
        "operation": "populate",
        "payload": {},
        "validation_rules": [],
        "requires_confirmation": false,
        "updates": [
          {
            "target": "state.promptText",
            "expr": "'Landing page for a job search platform'"
          }
        ]
      }
    },
    "feedback": {
      "generateDesign": {
        "action_id": "generateDesign",
        "loading_indicator": "spinner",
        "success_message": "Design generated successfully",
        "error_message": "Failed to generate design",
        "ui_updates": []
      }
    }
  },
  "component_ir": {
    "library": "antd",
    "theme": {
      "primaryColor": "#6C5CE7",
      "secondaryColor": "#A29BFE",
      "fontFamily": "Inter",
      "borderRadius": 8
