{
  "page_ir": {
    "page_goal": "Display truck availability across different colors with status tracking (occupied, available, unassigned) and enable assignment of available trucks to drivers for movement",
    "style": {
      "tone": "professional",
      "theme": "monochrome loft",
      "density": "comfortable",
      "color_intent": "neutral"
    },
    "accessibility": {
      "required_labels": [
        "truck_status",
        "driver_assignment",
        "color_filter"
      ]
    },
    "responsive": {
      "breakpoints": {
        "mobile": 768,
        "tablet": 1024,
        "desktop": 1440
      },
      "collapse_rules": [
        "stack_filters_on_mobile"
      ],
      "hidden_on_small": []
    },
    "constraints": [
      "full_screen_layout"
    ]
  },
  "data_ir": {
    "state": {
      "trucks": {
        "type": "array",
        "initial": [
          {
            "id": "T001",
            "model": "Volvo FH16",
            "color": "White",
            "status": "available",
            "driver": null,
            "lastMaintenance": "2024-01-15",
            "mileage": 45000
          },
          {
            "id": "T002",
            "model": "Scania R500",
            "color": "Black",
            "status": "occupied",
            "driver": "John Smith",
            "lastMaintenance": "2024-01-10",
            "mileage": 52000
          },
          {
            "id": "T003",
            "model": "Mercedes Actros",
            "color": "Silver",
            "status": "available",
            "driver": null,
            "lastMaintenance": "2024-01-20",
            "mileage": 38000
          },
          {
            "id": "T004",
            "model": "MAN TGX",
            "color": "White",
            "status": "unassigned",
            "driver": null,
            "lastMaintenance": "2024-01-05",
            "mileage": 61000
          },
          {
            "id": "T005",
            "model": "DAF XF",
            "color": "Gray",
            "status": "occupied",
            "driver": "Sarah Johnson",
            "lastMaintenance": "2024-01-18",
            "mileage": 47000
          },
          {
            "id": "T006",
            "model": "Iveco Stralis",
            "color": "Black",
            "status": "available",
            "driver": null,
            "lastMaintenance": "2024-01-22",
            "mileage": 33000
          },
          {
            "id": "T007",
            "model": "Volvo FH16",
            "color": "Silver",
            "status": "unassigned",
            "driver": null,
            "lastMaintenance": "2024-01-12",
            "mileage": 55000
          },
          {
            "id": "T008",
            "model": "Scania R500",
            "color": "White",
            "status": "available",
            "driver": null,
            "lastMaintenance": "2024-01-25",
            "mileage": 29000
          }
        ],
        "required": true,
        "constraints": {}
      },
      "drivers": {
        "type": "array",
        "initial": [
          {
            "id": "D001",
            "name": "Michael Brown",
            "license": "CDL-A",
            "status": "available",
            "rating": 4.8
          },
          {
            "id": "D002",
            "name": "Emily Davis",
            "license": "CDL-A",
            "status": "available",
            "rating": 4.9
          },
          {
            "id": "D003",
            "name": "Robert Wilson",
            "license": "CDL-B",
            "status": "available",
            "rating": 4.6
          },
          {
            "id": "D004",
            "name": "Jennifer Martinez",
            "license": "CDL-A",
            "status": "available",
            "rating": 4.7
          },
          {
            "id": "D005",
            "name": "David Anderson",
            "license": "CDL-A",
            "status": "available",
            "rating": 4.5
          }
        ],
        "required": true,
        "constraints": {}
      },
      "selectedTruck": {
        "type": "object",
        "initial": null,
        "required": false,
        "constraints": {}
      },
      "selectedDriver": {
        "type": "string",
        "initial": null,
        "required": false,
        "constraints": {}
      },
      "filterColor": {
        "type": "string",
        "initial": "all",
        "required": false,
        "constraints": {}
      },
      "filterStatus": {
        "type": "string",
        "initial": "all",
        "required": false,
        "constraints": {}
      },
      "searchQuery": {
        "type": "string",
        "initial": "",
        "required": false,
        "constraints": {}
      },
      "assignmentModalVisible": {
        "type": "boolean",
        "initial": false,
        "required": false,
        "constraints": {}
      }
    },
    "derived": {
      "filteredTrucks": {
        "type": "array",
        "expr": "state.trucks.filter(t => (state.filterColor === 'all' || t.color === state.filterColor) && (state.filterStatus === 'all' || t.status === state.filterStatus) && (state.searchQuery === '' || t.id.includes(state.searchQuery) || t.model.toLowerCase().includes(state.searchQuery.toLowerCase())))"
      },
      "availableTrucksCount": {
        "type": "number",
        "expr": "state.trucks.filter(t => t.status === 'available').length"
      },
      "occupiedTrucksCount": {
        "type": "number",
        "expr": "state.trucks.filter(t => t.status === 'occupied').length"
      },
      "unassignedTrucksCount": {
        "type": "number",
        "expr": "state.trucks.filter(t => t.status === 'unassigned').length"
      },
      "availableDrivers": {
        "type": "array",
        "expr": "state.drivers.filter(d => d.status === 'available')"
      }
    }
  },
  "data_model_ir": {
    "entities": {
      "truck": {
        "name": "Truck",
        "fields": [
          "id",
          "model",
          "color",
          "status",
          "driver",
          "lastMaintenance",
          "mileage"
        ],
        "computed": [],
        "display_fields": [
          "id",
          "model",
          "color",
          "status"
        ],
        "filters": [
          "color",
          "status"
        ]
      },
      "driver": {
        "name": "Driver",
        "fields": [
          "id",
          "name",
          "license",
          "status",
          "rating"
        ],
        "computed": [],
        "display_fields": [
          "name",
          "license",
          "rating"
        ],
        "filters": [
          "status"
        ]
      }
    }
  },
  "behaviour_ir": {
    "events": {
      "onTruckSelect": {
        "type": "mutation",
        "updates": [
          {
            "target": "state.selectedTruck",
            "expr": "payload.truck"
          }
        ]
      },
      "onColorFilterChange": {
        "type": "mutation",
        "updates": [
          {
            "target": "state.filterColor",
            "expr": "payload.color"
          }
        ]
      },
      "onStatusFilterChange": {
        "type": "mutation",
        "updates": [
          {
            "target": "state.filterStatus",
            "expr": "payload.status"
          }
        ]
      },
      "onSearchChange": {
        "type": "mutation",
        "updates": [
          {
            "target": "state.searchQuery",
            "expr": "payload.query"
          }
        ]
      },
      "onDriverSelect": {
        "type": "mutation",
        "updates": [
          {
            "target": "state.selectedDriver",
            "expr": "payload.driverId"
          }
        ]
      },
      "onOpenAssignmentModal": {
        "type": "mutation",
        "updates": [
          {
            "target": "state.assignmentModalVisible",
            "expr": "true"
          },
          {
            "target": "state.selectedTruck",
            "expr": "payload.truck"
          }
        ]
      },
      "onCloseAssignmentModal": {
        "type": "mutation",
        "updates": [
          {
            "target": "state.assignmentModalVisible",
            "expr": "false"
          },
          {
            "target": "state.selectedTruck",
            "expr": "null"
          },
          {
            "target": "state.selectedDriver",
            "expr": "null"
          }
        ]
      },
      "onAssignDriver": {
        "type": "mutation",
        "updates": [
          {
            "target": "state.trucks",
            "expr": "state.trucks.map(t => t.id === state.selectedTruck.id ? {...t, driver: state.drivers.find(d => d.id === state.selectedDriver).name, status: 'occupied'} : t)"
          },
          {
            "target": "state.assignmentModalVisible",
            "expr": "false"
          },
          {
            "target": "state.selectedTruck",
            "expr": "null"
          },
          {
            "target": "state.selectedDriver",
            "expr": "null"
          }
        ]
      },
      "onUnassignDriver": {
        "type": "mutation",
        "updates": [
          {
            "target": "state.trucks",
            "expr": "state.trucks.map(t => t.id === payload.truckId ? {...t, driver: null, status: 'available'} : t)"
          }
        ]
      }
    },
    "actions": {
      "assignDriverAction": {
        "action_id": "assignDriverAction",
        "trigger": "button_click",
        "target_component_id": "assign_button",
        "operation": "assign_driver",
        "payload": {},
        "validation_rules": [
          "selectedDriver_required"
        ],
        "requires_confirmation": true,
        "updates": [
          {
            "target": "state.trucks",
            "expr": "state.trucks.map(t => t.id === state.selectedTruck.id ? {...t, driver: state.drivers.find(d => d.id === state.selectedDriver).name, status: 'occupied'} : t)"
          }
        ]
      },
      "unassignDriverAction": {
        "action_id": "unassignDriverAction",
        "trigger": "button_click",
        "target_component_id": "unassign_button",
        "operation": "unassign_driver",
        "payload": {},
        "validation_rules": [],
        "requires_confirmation": true,
        "updates": [
          {
            "target": "state.trucks",
            "expr": "state.trucks.map(t => t.id === payload.truckId ? {...t, driver: null, status: 'available'} : t)"
          }
        ]
      }
    },
    "feedback": {
      "assignDriverAction": {
        "action_id": "assignDriverAction",
        "loading_indicator": "spinner",
        "success_message": "Driver assigned successfully",
        "error_message": "Failed to assign driver",
        "ui_updates": []
      },
      "unassignDriverAction": {
        "action_id": "unassignDriverAction",
        "loading_indicator": "spinner",
        "success_message": "Driver unassigned successfully",
        "error_message": "Failed to unassign driver",
        "ui_updates": []
      }
    }
  },
  "component_ir": {
    "library": "antd",
    "theme": {
      "primaryColor": "#2c2c2c",
      "secondaryColor": "#6c6c6c",
      "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "borderRadius": 2
    },
    "components": {
      "root_container": {
        "type": "div",
        "label": null,
        "bind": null,
        "onClick": null,
        "props": {},
        "styles": {
          "width": "100vw",
          "height": "100vh",
          "backgroundColor": "#f5f5f5",
          "overflow": "hidden",
          "display": "flex",
          "flexDirection": "column"
        }
      },
      "header_section": {
        "type": "div",
        "label": null,
        "bind": null,
        "onClick": null,
        "props": {},
        "styles": {
          "backgroundColor": "#2c2c2c",
          "padding": "24px 32px",
          "borderBottom": "1px solid #1a1a1a"
        }
      },
      "page_title": {
        "type": "Typography.Title",
        "label": "Truck and Driver Assignment",
        "bind": null,
        "onClick": null,
        "props": {
          "level": 2
        },
        "styles": {
          "color": "#ffffff",
          "margin": 0,
          "fontWeight": 300,
          "letterSpacing": "0.5px"
        }
      },
      "stats_container": {
        "type": "div",
        "label": null,
        "bind": null,
        "onClick": null,
        "props": {},
        "styles": {
          "display": "flex",
          "gap": "16px",
          "marginTop": "16px"
        }
      },
      "stat_available": {
        "type": "Card",
        "label": null,
        "bind": "derived.availableTrucksCount",
        "onClick": null,
        "props": {
          "size": "small"
        },
        "styles": {
          "flex": 1,
          "backgroundColor": "#ffffff",
          "border": "1px solid #e0e0e0"
        }
      },
      "stat_occupied": {
        "type": "Card",
        "label": null,
        "bind": "derived.occupiedTrucksCount",
        "onClick": null,
        "props": {
          "size": "small"
        },
        "styles": {
          "flex": 1,
          "backgroundColor": "#ffffff",
          "border": "1px solid #e0e0e0"
        }
      },
      "stat_unassigned": {
        "type": "Card",
        "label": null,
        "bind": "derived.unassignedTrucksCount",
        "onClick": null,
        "props": {
          "size": "small"
        },
        "styles": {
          "flex": 1,
          "backgroundColor": "#ffffff",
          "border": "1px solid #e0e0e0"
        }
      },
      "main_content": {
        "type": "div",
        "label": null,
        "bind": null,
        "onClick": null,
        "props": {},
        "styles": {
          "flex": 1,
          "padding": "32px",
          "overflow": "auto"
        }
      },
      "filters_section": {
        "type": "div",
        "label": null,
        "bind": null,
        "onClick": null,
        "props": {},
        "styles": {
          "display": "flex",
          "gap": "16px",
          "marginBottom": "24px",
          "alignItems": "center",
          "backgroundColor": "#ffffff",
          "padding": "20px",
          "border": "1px solid #e0e0e0"
        }
      },
      "search_input": {
        "type": "Input.Search",
        "label": null,
        "bind": "state.searchQuery",
        "onClick": null,
        "props": {
          "placeholder": "Search by truck ID or model",
          "allowClear": true
        },
        "styles": {
          "width": "300px"
        }
      },
      "color_filter": {
        "type": "Select",
        "label": null,
        "bind": "state.filterColor",
        "onClick": null,
        "props": {
          "placeholder": "Filter by color",
          "options": [
            {
              "label": "All Colors",
              "value": "all"
            },
            {
              "label": "White",
              "value": "White"
            },
            {
              "label": "Black",
              "value": "Black"
            },
            {
              "label": "Silver",
              "value": "Silver"
            },
            {
              "label": "Gray",
              "value": "Gray"
            }
          ]
        },
        "styles": {
          "width": "180px"
        }
      },
      "status_filter": {
        "type": "Select",
        "label": null,
        "bind": "state.filterStatus",
        "onClick": null,
        "props": {
          "placeholder": "Filter by status",
          "options": [
            {
              "label": "All Status",
              "value": "all"
            },
            {
              "label": "Available",
              "value": "available"
            },
            {
              "label": "Occupied",
              "value": "occupied"
            },
            {
              "label": "Unassigned",
              "value": "unassigned"
            }
          ]
        },
        "styles": {
          "width": "180px"
        }
      },
      "trucks_grid": {
        "type": "div",
        "label": null,
        "bind": null,
        "onClick": null,
        "props": {},
        "styles": {
          "display": "grid",
          "gridTemplateColumns": "repeat(auto-fill, minmax(320px, 1fr))",
          "gap": "20px"
        }
      },
      "truck_card": {
        "type": "Card",
        "label": null,
        "bind": "derived.filteredTrucks",
        "onClick": null,
        "props": {
          "hoverable": true
        },
        "styles": {
          "backgroundColor": "#ffffff",
          "border": "1px solid #e0e0e0",
          "transition": "all 0.3s"
        }
      },
      "assignment_modal": {
        "type": "Modal",
        "label": "Assign Driver",
        "bind": "state.assignmentModalVisible",
        "onClick": null,
        "props": {
          "title": "Assign Driver to Truck",
          "open": true,
          "onCancel": "onCloseAssignmentModal",
          "footer": null,
          "width": 600
        },
        "styles": {}
      },
      "modal_content": {
        "type": "div",
        "label": null,
        "bind": null,
        "onClick": null,
        "props": {},
        "styles": {
          "padding": "20px 0"
        }
      },
      "truck_info_section": {
        "type": "div",
        "label": null,
        "bind": null,
        "onClick": null,
        "props": {},
        "styles": {
          "marginBottom": "24px",
          "padding": "16px",
          "backgroundColor": "#fafafa",
          "border": "1px solid #e0e0e0"
        }
      },
      "driver_select": {
        "type": "Select",
        "label": null,
        "bind": "state.selectedDriver",
        "onClick": null,
        "props": {
          "placeholder": "Select an available driver",
          "style": {
            "width": "100%"
          }
        },
        "styles": {
          "marginBottom": "20px"
        }
      },
      "assign_button": {
        "type": "Button",
        "label": "Assign Driver",
        "bind": null,
        "onClick": "onAssignDriver",
        "props": {
          "type": "primary",
          "block": true,
          "size": "large"
        },
        "styles": {
          "backgroundColor": "#2c2c2c",
          "borderColor": "#2c2c2c"
        }
      },
      "unassign_button": {
        "type": "Button",
        "label": "Unassign",
        "bind": null,
        "onClick": "onUnassignDriver",
        "props": {
          "danger": true,
          "size": "small"
        },
        "styles": {}
      },
      "assign_truck_button": {
        "type": "Button",
        "label": "Assign Driver",
        "bind": null,
        "onClick": "onOpenAssignmentModal",
        "props": {
          "type": "primary",
          "size": "small",
          "block": true
        },
        "styles": {
          "backgroundColor": "#2c2c2c",
          "borderColor": "#2c2c2c"
        }
      }
    }
  },
  "layout_ir": {
    "root": "root_container",
    "children": {
      "root_container": [
        "header_section",
        "main_content",
        "assignment_modal"
      ],
      "header_section": [
        "page_title",
        "stats_container"
      ],
      "stats_container": [
        "stat_available",
        "stat_occupied",
        "stat_unassigned"
      ],
      "main_content": [
        "filters_section",
        "trucks_grid"
      ],
      "filters_section": [
        "search_input",
        "color_filter",
        "status_filter"
      ],
      "trucks_grid": [
        "truck_card"
      ],
      "assignment_modal": [
        "modal_content"
      ],
      "modal_content": [
        "truck_info_section",
        "driver_select",
        "assign_button"
      ]
    },
    "layout": {
      "root_container": {
        "type": "vertical",
        "gap": 0
      },
      "header_section": {
        "type": "vertical",
        "gap": 16
      },
      "stats_container": {
        "type": "horizontal",
        "gap": 16
      },
      "main_content": {
        "type": "vertical",
        "gap": 24
      },
      "filters_section": {
        "type": "horizontal",
        "gap": 16
      },
      "trucks_grid": {
        "type": "grid",
        "gap": 20
      },
      "modal_content": {
        "type": "vertical",
        "gap": 16
      }
    },
    "layout_zones": [
      {
        "zone_id": "header_zone",
        "component": "header_section",
        "anchor": "top-left",
        "size_hint": "full-width",
        "z_layer": "base",
        "notes": "Fixed header with title and statistics"
      },
      {
        "zone_id": "main_zone",
        "component": "main_content",
        "anchor": "center",
        "size_hint": "full-width",
        "z_layer": "base",
        "notes": "Main content area with filters and truck grid"
      },
      {
        "zone_id": "modal_zone",
        "component": "assignment_modal",
        "anchor": "center",
        "size_hint": "auto",
        "z_layer": "overlay",
        "notes": "Modal for driver assignment"
      }
    ]
  }
}
