  "behaviour_ir": {
    "events": {
      "calculate_results": {
        "type": "mutation",
        "updates": [
          {
            "target": "state.student1_percentage",
            "expr": "((state.student1_nepali + state.student1_english + state.student1_mathematics + state.student1_science + state.student1_social) / 5)"
          },
          {
            "target": "state.student1_gpa",
            "expr": "(((state.student1_nepali + state.student1_english + state.student1_mathematics + state.student1_science + state.student1_social) / 5) / 25)"
          },
          {
            "target": "state.student1_grade",
            "expr": "((state.student1_nepali + state.student1_english + state.student1_mathematics + state.student1_science + state.student1_social) / 5) >= 90 ? 'A+' : ((state.student1_nepali + state.student1_english + state.student1_mathematics + state.student1_science + state.student1_social) / 5) >= 80 ? 'A' : ((state.student1_nepali + state.student1_english + state.student1_mathematics + state.student1_science + state.student1_social) / 5) >= 70 ? 'B+' : ((state.student1_nepali + state.student1_english + state.student1_mathematics + state.student1_science + state.student1_social) / 5) >= 60 ? 'B' : ((state.student1_nepali + state.student1_english + state.student1_mathematics + state.student1_science + state.student1_social) / 5) >= 50 ? 'C+' : ((state.student1_nepali + state.student1_english + state.student1_mathematics + state.student1_science + state.student1_social) / 5) >= 40 ? 'C' : 'F'"
          },
          {
            "target": "state.student2_percentage",
            "expr": "((state.student2_nepali + state.student2_english + state.student2_mathematics + state.student2_science + state.student2_social) / 5)"
          },
