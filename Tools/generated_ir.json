  "data_model_ir": {
    "entities": {
      "student": {
        "name": "Student",
        "fields": [
          "id",
          "name",
          "height",
          "weight"
        ],
        "computed": [
          "bmi",
          "bmi_category"
        ],
        "display_fields": [
          "name",
          "height",
          "weight",
          "bmi",
          "bmi_category"
        ],
        "search_fields": [],
        "filters": [
          "name"
        ],
        "default_sort": null,
        "default_sort_dir": "asc"
      }
    },
    "relationships": [],
    "external_source_ref": {
      "source_id": "student_external",
      "snapshot_path": "db/external_db_snapshot.json",
      "db_path": "/db/student_data.db"
    },
    "sql_query_ir": {
      "sql_template": "SELECT id, name, height, weight FROM student_data WHERE (:search = '' OR name LIKE '%' || :search || '%') ORDER BY name LIMIT :limit OFFSET :offset",
      "params": [
        ":limit",
        ":offset",
        ":search"
      ],
      "default_page_size": 50,
      "max_page_size": 200
    }
  },
  "behaviour_ir": {
    "events": {
      "search_change": {
        "type": "mutation",
        "updates": [
          {
            "target": "state.search",
            "expr": "event.target.value"
          },
          {
            "target": "state.page",
            "expr": "1"
          }
        ],
        "description": ""
      },
      "page_change": {
        "type": "mutation",
        "updates": [
          {
            "target": "state.page",
            "expr": "event.page"
          },
          {
            "target": "state.pageSize",
            "expr": "event.pageSize"
          }
        ],
        "description": ""
      },
      "calculate_manual_bmi": {
        "type": "mutation",
        "updates": [
          {
            "target": "state.calculatedBMI",
            "expr": "state.manualHeight > 0 && state.manualWeight > 0 ? state.manualWeight / Math.pow(state.manualHeight / 100, 2) : 0"
          }
        ],
        "description": ""
      }
    },
    "actions": {
      "load_students": {
        "action_id": "load_students",
        "trigger": "button_click",
        "target_component_id": "refresh_button",
        "operation": "read",
        "description": "",
        "payload": {
          "query": "sql_query_ir",
          "params": {
            "limit": "state.pageSize",
            "offset": "(state.page - 1) * state.pageSize",
            "search": "state.search"
          }
        },
        "guard": null,
        "requires_confirmation": false,
        "confirmation_message": null,
        "validation_rules": [],
        "validation_messages": {},
        "updates": [
