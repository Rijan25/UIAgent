  "data_model_ir": {
    "entities": {
      "student": {
        "name": "Student",
        "fields": [
          "id",
          "name",
          "height",
          "weight",
          "total_marks"
        ],
        "computed": [],
        "display_fields": [
          "name",
          "height",
          "weight",
          "total_marks"
        ],
        "search_fields": [],
        "filters": [],
        "default_sort": null,
        "default_sort_dir": "asc"
      }
    },
    "relationships": [],
    "external_source_ref": {
      "source_id": "student_external",
      "snapshot_path": "db/external_db_snapshot.json",
      "db_path": "/db/student_data.db"
    },
    "sql_query_ir": {
      "sql_template": "SELECT sd.id, sd.name, sd.height, sd.weight, (sm.nepali + sm.english + sm.mathematics + sm.science + sm.social_studies) as total_marks FROM student_data sd LEFT JOIN student_marks sm ON sd.id = sm.student_id WHERE (:search = '' OR sd.name LIKE '%' || :search || '%') AND sd.height >= :minHeight AND sd.height <= :maxHeight AND (sm.nepali + sm.english + sm.mathematics + sm.science + sm.social_studies) >= :minMarks AND (sm.nepali + sm.english + sm.mathematics + sm.science + sm.social_studies) <= :maxMarks ORDER BY sd.name LIMIT :limit OFFSET :offset",
      "params": [
        ":limit",
        ":offset",
        ":search",
        ":minHeight",
        ":maxHeight",
        ":minMarks",
        ":maxMarks"
      ],
      "default_page_size": 50,
      "max_page_size": 200
    }
  },
