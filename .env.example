# ----------------------------
# AWS / Bedrock configuration
# ----------------------------

# Option A: Use profile
AWS_PROFILE=default

# Option B: Use explicit credentials
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
AWS_SESSION_TOKEN=

# Region (any one is fine; BEDROCK_AWS_REGION takes precedence in code)
BEDROCK_AWS_REGION=us-east-1
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Bedrock model (or inference profile ID/ARN)
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# Optional alternative key supported by code
ANTHROPIC_BEDROCK_MODEL=

# ----------------------------
# Logging
# ----------------------------
UIAGENT_LOG_LEVEL=INFO
UIAGENT_RUN_ID=

# ----------------------------
# Optional lowercase aliases (legacy support)
# ----------------------------
aws_profile=
aws_access_key=
aws_secret_key=
aws_session_token=
aws_region=
